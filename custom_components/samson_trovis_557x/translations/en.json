{
  "config": {
    "step": {
      "user": {
        "title": "Connection",
        "description": "Pick a serial interface already known to Home Assistant.\n\n**OR**\n\nEnter the connection data manually in one of the following formats:\n\n- `ip_address:port`\n  Native Modbus/TCP connection, e.g. via a serial-to-Ethernet adapter running a Modbus TCP server (default port: 502).\n\n- `socket://ip_address:port`\n  Modbus RTU over a transparent TCP connection, e.g. a serial-to-Ethernet adapter in transparent mode.\n\n- `/dev/serial/by-id/...`, `/dev/ttyUSB...`, `/dev/...`\n  Modbus RTU over a physical or virtual local serial interface, e.g. a USB-to-serial adapter or `socat` device. This is usually auto-filled by selecting a known interface.\n\n- `esphome-hass://esphome/ID?port_name=PORT`\n  Modbus RTU via an ESPHome Serial Proxy using a remote ESP UART. This is usually auto-filled by selecting a known interface.\n\nThe controller is probed before setup continues.",
        "data": {
          "connection": "Interface for the communication to the Trovis.",
          "unit_id": "Trovis unique Modbus address (PA6; default 246).",
          "baudrate": "Trovis serial speed setting (PA6; default 19.200)."
        }
      },
      "device": {
        "title": "Device setup",
        "data": {
          "name": "Unique name",
          "slug": "Entity ID prefix",
          "access_code": "Access code"
        },
        "data_description": {
          "name": "Unique display name for this controller, e.g. 'SAMSON TROVIS'. Use a different name for each controller.",
          "slug": "Prefix for generated entity IDs, e.g. 't5578'. This results in IDs such as 'sensor.t5578_sensor_af1'.",
          "access_code": "The number code for write access (see the last page in the device manual)."
        }
      },
      "reconfigure": {
        "title": "Reconfigure controller",
        "description": "Pick a serial interface already known to Home Assistant.\n\n**OR**\n\nEnter the connection data manually in one of the following formats:\n\n- `ip_address:port`\n  Native Modbus/TCP connection, e.g. via a serial-to-Ethernet adapter running a Modbus TCP server (default port: 502).\n\n- `socket://ip_address:port`\n  Modbus RTU over a transparent TCP connection, e.g. a serial-to-Ethernet adapter in transparent mode.\n\n- `/dev/serial/by-id/...`, `/dev/ttyUSB...`, `/dev/...`\n  Modbus RTU over a physical or virtual local serial interface, e.g. a USB-to-serial adapter or `socat` device. This is usually auto-filled by selecting a known interface.\n\n- `esphome-hass://esphome/ID?port_name=PORT`\n  Modbus RTU via an ESPHome Serial Proxy using a remote ESP UART. This is usually auto-filled by selecting a known interface.\n\nThe controller model and connected sensors are detected again automatically.",
        "data": {
          "connection": "Interface for the communication to the Trovis.",
          "unit_id": "Trovis unique Modbus address (PA6; default 246).",
          "baudrate": "Trovis serial speed setting (PA6; default 19.200).",
          "name": "Unique name",
          "access_code": "Access code"
        },
        "data_description": {
          "name": "Unique display name for this controller.",
          "access_code": "The number code for write access."
        }
      }
    },
    "error": {
      "cannot_connect": "Failed to communicate with the controller. Check the connection settings, unit ID and controller availability.",
      "connection_required": "Select a known serial interface or enter a connection.",
      "invalid_connection": "The connection is not valid. Use /dev/..., esphome-hass://..., socket://host:port, or host:port."
    },
    "abort": {
      "reconfigure_successful": "Reconfiguration was successful."
    }
  },
